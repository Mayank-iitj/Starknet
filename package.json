{
  "name": "starknet-defi-app",
  "version": "1.0.0",
  "description": "Next-generation permissionless financial application on Starknet with micro-payments, Bitcoin bridging, and privacy features",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:contracts && npm run build:frontend && npm run build:mobile",
    "build:contracts": "cd contracts && scarb build",
    "build:frontend": "cd frontend && npm run build",
    "build:mobile": "cd mobile && npm run build",
    "test": "npm run test:contracts && npm run test:frontend",
    "test:contracts": "cd contracts && scarb test",
    "test:frontend": "cd frontend && npm run test",
    "deploy": "cd contracts && scarb run deploy",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:mobile\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:mobile": "cd mobile && npm run dev",
    "start": "npm run dev",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write ."
  },
  "keywords": [
    "starknet",
    "defi",
    "bitcoin",
    "privacy",
    "zero-knowledge",
    "micro-payments",
    "mobile-first",
    "cairo"
  ],
  "author": "StarkNet DeFi Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "@starknet-io/types-js": "^0.7.7",
    "starknet": "^6.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}